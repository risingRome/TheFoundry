@model OpsDashboard.Application.GeneratedDashboards.GeneratedDashboardDto
@using System.Text.Json
@{
    ViewData["Title"] = "Generated Dashboard";
    var chartOptions = new JsonSerializerOptions(JsonSerializerDefaults.Web);
    var canSaveDashboard = User.IsInRole("Admin") || User.IsInRole("Analyst");
}

<section class="page-heading">
    <div>
        <div class="page-eyebrow">Auto dashboard generator</div>
        <h1 class="page-title">@Model.DatasetName</h1>
        <p class="page-subtitle">@Model.DomainName &middot; @Model.BusinessDomain &middot; Generated from detected entities and dimensions</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-outline-secondary" asp-controller="Insights" asp-action="Index">Back</a>
        <a class="btn btn-outline-secondary" asp-controller="Assistant" asp-action="Index" asp-route-datasetId="@Model.DatasetId" asp-route-from="@Model.Filters.From" asp-route-to="@Model.Filters.To" asp-route-department="@Selected("department")" asp-route-region="@Selected("region")" asp-route-employee="@Selected("employee")" asp-route-product="@Selected("product")" asp-route-category="@Selected("category")"><i data-lucide="message-circle"></i> Assistant</a>
        <a class="btn btn-primary foundry-button" asp-controller="Reports" asp-action="Details" asp-route-datasetId="@Model.DatasetId" asp-route-from="@Model.Filters.From" asp-route-to="@Model.Filters.To" asp-route-department="@Selected("department")" asp-route-region="@Selected("region")" asp-route-employee="@Selected("employee")" asp-route-product="@Selected("product")" asp-route-category="@Selected("category")"><i data-lucide="file-text"></i><span>Generate Report</span></a>
        <a class="btn btn-primary foundry-button" asp-controller="Datasets" asp-action="Preview" asp-route-id="@Model.DatasetId"><i data-lucide="table"></i><span>Preview data</span></a>
    </div>
</section>

@if (canSaveDashboard)
{
    <section class="panel save-dashboard-panel">
        <form class="save-dashboard-form" asp-controller="DashboardLibrary" asp-action="Save" method="post">
            <input type="hidden" name="datasetId" value="@Model.DatasetId" />
            <input type="hidden" name="from" value="@Model.Filters.From?.ToString("yyyy-MM-dd")" />
            <input type="hidden" name="to" value="@Model.Filters.To?.ToString("yyyy-MM-dd")" />
            <input type="hidden" name="department" value="@Selected("department")" />
            <input type="hidden" name="region" value="@Selected("region")" />
            <input type="hidden" name="employee" value="@Selected("employee")" />
            <input type="hidden" name="product" value="@Selected("product")" />
            <input type="hidden" name="category" value="@Selected("category")" />
            <div>
                <label class="form-label" for="dashboardName">Save dashboard</label>
                <input class="form-control foundry-input" id="dashboardName" name="name" value="@($"{Model.DatasetName} dashboard")" maxlength="180" />
            </div>
            <button class="btn btn-primary foundry-button" type="submit"><i data-lucide="save"></i><span>Save Dashboard</span></button>
        </form>
    </section>
}

<section class="filter-banner">
    <div><i data-lucide="filter"></i><span>@Model.Filters.Summary</span></div>
    @if (Model.Filters.HasActiveFilters)
    {
        <a class="btn btn-outline-secondary btn-sm" asp-controller="GeneratedDashboard" asp-action="Index" asp-route-datasetId="@Model.DatasetId">Reset Filters</a>
    }
</section>

<section class="panel filter-panel">
    <form method="get" action="/GeneratedDashboard/@Model.DatasetId">
        <div class="filter-grid">
            @if (HasFilter("date"))
            {
                <div>
                    <label class="form-label" for="from">From</label>
                    <input class="form-control foundry-input" id="from" name="from" type="date" value="@Model.Filters.From?.ToString("yyyy-MM-dd")" />
                </div>
                <div>
                    <label class="form-label" for="to">To</label>
                    <input class="form-control foundry-input" id="to" name="to" type="date" value="@Model.Filters.To?.ToString("yyyy-MM-dd")" />
                </div>
            }
            @foreach (var option in Model.Filters.Options.Where(x => x.Key != "date"))
            {
                <div>
                    <label class="form-label" for="@option.Key">@option.Label</label>
                    <select class="form-select foundry-input" id="@option.Key" name="@option.Key">
                        <option value="">All @option.Label</option>
                        @foreach (var value in option.Values)
                        {
                            <option value="@value" selected="@(string.Equals(option.SelectedValue, value, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">@value</option>
                        }
                    </select>
                </div>
            }
        </div>
        <div class="form-actions mt-3">
            <a class="btn btn-outline-secondary" asp-controller="GeneratedDashboard" asp-action="Index" asp-route-datasetId="@Model.DatasetId">Reset Filters</a>
            <button class="btn btn-primary foundry-button" type="submit"><i data-lucide="sliders-horizontal"></i><span>Apply Filters</span></button>
        </div>
    </form>
</section>

<section class="kpi-grid">
    @foreach (var kpi in Model.Kpis)
    {
        <article class="kpi-card status-green">
            <div class="kpi-head">
                <span class="kpi-name">@kpi.Title</span>
                <span class="kpi-indicator"></span>
            </div>
            <div class="kpi-value">@kpi.Value</div>
            <div class="kpi-target"><i data-lucide="sparkles"></i><span>@kpi.Description</span></div>
        </article>
    }
</section>

<div class="dashboard-grid generated-layout">
    <section class="panel">
        <div class="panel-header">
            <div>
                <h2 class="panel-title">Trend charts</h2>
                <p class="panel-subtitle">Generated when a measure is paired with a date dimension.</p>
            </div>
            <span class="panel-badge">@Model.TrendCharts.Count charts</span>
        </div>
        <div class="generated-chart-stack">
            @if (Model.TrendCharts.Count == 0)
            {
                <p class="table-muted">No trend chart rules matched this dataset.</p>
            }
            @foreach (var chart in Model.TrendCharts)
            {
                <div class="generated-chart">
                    <div class="mini-panel-header">
                        <strong>@chart.Title</strong>
                        <span>@chart.Subtitle</span>
                    </div>
                    <div class="chart-wrap compact"><canvas id="@chart.Id"></canvas></div>
                </div>
            }
        </div>
    </section>

    <section class="panel">
        <div class="panel-header">
            <div>
                <h2 class="panel-title">Comparison charts</h2>
                <p class="panel-subtitle">Generated from measure and dimension pairings.</p>
            </div>
            <span class="panel-badge">@Model.ComparisonCharts.Count charts</span>
        </div>
        <div class="generated-chart-stack">
            @if (Model.ComparisonCharts.Count == 0)
            {
                <p class="table-muted">No comparison chart rules matched this dataset.</p>
            }
            @foreach (var chart in Model.ComparisonCharts)
            {
                <div class="generated-chart">
                    <div class="mini-panel-header">
                        <strong>@chart.Title</strong>
                        <span>@chart.Subtitle</span>
                    </div>
                    <div class="chart-wrap compact"><canvas id="@chart.Id"></canvas></div>
                </div>
            }
        </div>
    </section>
</div>

<section class="panel mt-3">
    <div class="panel-header">
        <div>
            <h2 class="panel-title">Summary table</h2>
            <p class="panel-subtitle">First 25 rows from the generated dashboard dataset.</p>
        </div>
        <span class="panel-badge">@Model.SummaryRows.Count rows</span>
    </div>
    <div class="table-responsive preview-table-wrap">
        <table class="table align-middle preview-table">
            <thead>
            <tr>
                @foreach (var column in Model.SummaryColumns)
                {
                    <th>@column</th>
                }
            </tr>
            </thead>
            <tbody>
            @foreach (var row in Model.SummaryRows)
            {
                <tr>
                    @foreach (var cell in row)
                    {
                        <td>@(string.IsNullOrWhiteSpace(cell) ? "-" : cell)</td>
                    }
                </tr>
            }
            </tbody>
        </table>
    </div>
</section>

@section Scripts {
    <script src="~/js/dashboard.js" asp-append-version="true"></script>
    <script>
        const generatedTrendCharts = @Html.Raw(JsonSerializer.Serialize(Model.TrendCharts, chartOptions));
        const generatedComparisonCharts = @Html.Raw(JsonSerializer.Serialize(Model.ComparisonCharts, chartOptions));

        generatedTrendCharts.forEach(chart => renderLineChart(chart.id, chart.labels, chart.values, chart.title));
        generatedComparisonCharts.forEach(chart => renderBarChart(chart.id, chart.labels, chart.values, chart.title));
    </script>
}

@functions {
    private bool HasFilter(string key)
    {
        return Model.Filters.Options.Any(x => x.Key == key) || (key == "date" && (Model.Filters.From.HasValue || Model.Filters.To.HasValue));
    }

    private string? Selected(string key)
    {
        return Model.Filters.Options.FirstOrDefault(x => x.Key == key)?.SelectedValue;
    }
}
