@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    string NavClass(string target) => controller == "Dashboard" && action == target ? "sidebar-link active" : "sidebar-link";
    string ControllerNavClass(string target) => controller == target ? "sidebar-link active" : "sidebar-link";
}
<!doctype html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#111827" />
    <title>@ViewData["Title"] | The Foundry</title>
    <script>
        (() => {
            const theme = localStorage.getItem('foundry-theme') ||
                (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
            document.documentElement.setAttribute('data-bs-theme', theme);
        })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Manrope:wght@600;700&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" asp-append-version="true" />
</head>
<body>
<div class="app-shell">
    <aside class="sidebar offcanvas-lg offcanvas-start" tabindex="-1" id="appSidebar" aria-labelledby="appSidebarLabel">
        <div class="offcanvas-header sidebar-mobile-header">
            <span class="visually-hidden" id="appSidebarLabel">Main navigation</span>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" data-bs-target="#appSidebar" aria-label="Close navigation"></button>
        </div>
        <a class="brand" asp-controller="Dashboard" asp-action="Executive" aria-label="The Foundry home">
            <span class="brand-mark" aria-hidden="true"><i data-lucide="layers-3"></i></span>
            <span>
                <strong>The Foundry</strong>
                <small>Business Intelligence Platform</small>
            </span>
        </a>

        <nav class="sidebar-nav" aria-label="Primary navigation">
            <div class="nav-label">Workspace</div>
            <a class="@NavClass("Executive")" asp-controller="Dashboard" asp-action="Executive">
                <i data-lucide="layout-dashboard"></i><span>Dashboard</span>
            </a>
            <a class="@NavClass("Team")" asp-controller="Dashboard" asp-action="Team">
                <i data-lucide="users"></i><span>Team performance</span>
            </a>
            <a class="@NavClass("Agent")" asp-controller="Dashboard" asp-action="Agent">
                <i data-lucide="user-round"></i><span>Agent insights</span>
            </a>
            <div class="nav-label nav-label-spaced">Foundation</div>
            <a class="@ControllerNavClass("Domains")" asp-controller="Domains" asp-action="Index">
                <i data-lucide="folder-tree"></i><span>Domains</span>
            </a>
            <a class="@ControllerNavClass("Datasets")" asp-controller="Datasets" asp-action="Index">
                <i data-lucide="database"></i><span>Datasets</span>
            </a>
            <a class="@ControllerNavClass("Insights")" asp-controller="Insights" asp-action="Index">
                <i data-lucide="sparkles"></i><span>Insights</span>
            </a>
            <a class="@ControllerNavClass("Reports")" asp-controller="Reports" asp-action="Index">
                <i data-lucide="file-text"></i><span>Reports</span>
            </a>
        </nav>

        <div class="sidebar-foot">
            <div class="environment-badge"><span></span> Operational data live</div>
            <div class="sidebar-version">The Foundry <span>v1.6.0</span></div>
        </div>
    </aside>

    <div class="app-main">
        <header class="topbar">
            <button class="icon-button d-lg-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#appSidebar" aria-controls="appSidebar" aria-label="Open navigation">
                <i data-lucide="menu"></i>
            </button>
            <div class="topbar-context d-none d-sm-block">
                <span>Operations</span><i data-lucide="chevron-right"></i><strong>@ViewData["Title"]</strong>
            </div>
            <div class="topbar-actions">
                <button class="icon-button" id="themeToggle" type="button" aria-label="Toggle dark mode" title="Toggle dark mode">
                    <i class="theme-icon-light" data-lucide="sun"></i>
                    <i class="theme-icon-dark" data-lucide="moon"></i>
                </button>
                <partial name="_LoginPartial" />
            </div>
        </header>

        <main class="content-area">
            @RenderBody()
        </main>

        <footer class="app-footer">
            <span>&copy; @DateTime.UtcNow.Year The Foundry</span>
            <span>Business Intelligence Platform &middot; Version 1.6.0</span>
        </footer>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
<script src="https://unpkg.com/lucide@0.468.0/dist/umd/lucide.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
