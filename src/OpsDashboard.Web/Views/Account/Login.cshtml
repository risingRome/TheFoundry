@model OpsDashboard.Web.Models.LoginViewModel
@{
    ViewData["Title"] = "Sign in";
}

<section class="auth-shell">
    <div class="auth-panel">
        <div class="auth-brand">
            <span class="brand-mark" aria-hidden="true"><i data-lucide="layers-3"></i></span>
            <div>
                <h1>The Foundry</h1>
                <p>Business Intelligence Platform</p>
            </div>
        </div>

        <form asp-action="Login" method="post">
            <input type="hidden" asp-for="ReturnUrl" />
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>
            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control foundry-input" autocomplete="username" />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" class="form-control foundry-input" autocomplete="current-password" />
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>
            <div class="form-check mb-4">
                <input asp-for="RememberMe" class="form-check-input" />
                <label asp-for="RememberMe" class="form-check-label"></label>
            </div>
            <button class="btn btn-primary foundry-button w-100 justify-content-center" type="submit">
                <i data-lucide="log-in"></i><span>Sign in</span>
            </button>
        </form>

        <div class="demo-users">
            <strong>Demo users</strong>
            <span>admin@foundry.local</span>
            <span>analyst@foundry.local</span>
            <span>executive@foundry.local</span>
            <span>viewer@foundry.local</span>
            <small>Password: Foundry!234</small>
        </div>
    </div>
</section>
